{
  "name": "mori",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:types": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:changed": "vitest run --changed",
    "lint": "eslint src",
    "format:check": "prettier eslint.config.js stylelint.config.js knip.json .prettierrc.json vite.config.ts --check",
    "format": "prettier eslint.config.js stylelint.config.js knip.json .prettierrc.json vite.config.ts --write",
    "style:check": "stylelint \"src/**/*.css\"",
    "unused": "knip --no-exit-code",
    "analyze": "vite build --mode analyze",
    "check:quick": "npm run check:types && npm run test:changed",
    "check:full": "npm run check:types && npm test",
    "check:release": "npm run check:types && npm test && npm run build",
    "generate:icons": "node scripts/generate-icons.cjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.1",
    "@lezer/highlight": "^1.2.3",
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/api": "^2.11.0",
    "@vitejs/plugin-react": "^5.1.1",
    "codemirror": "^6.0.2",
    "fflate": "^0.8.3",
    "lucide-react": "^0.561.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.1",
    "@types/node": "^22.19.19",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.4.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "knip": "^6.14.2",
    "prettier": "^3.8.3",
    "rollup-plugin-visualizer": "^7.0.1",
    "stylelint": "^17.12.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript-eslint": "^8.60.0",
    "vitest": "^4.1.6"
  }
}
