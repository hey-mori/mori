#!/usr/bin/env bash
#
# Reject a commit whose message breaks docs/commit-format.md before the commit
# exists, since published history is never rewritten here. The rule itself lives
# in scripts/validate-commit-message.sh. Installed by scripts/setup-git-hooks.sh.
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
if ! bash "$repo_root/scripts/validate-commit-message.sh" "$1"; then
  echo "" >&2
  echo "commit rejected: see docs/commit-format.md" >&2
  exit 1
fi
