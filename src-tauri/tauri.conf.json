{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mori",
  "version": "0.1.0",
  "identifier": "app.mori.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Mori",
        "width": 1440,
        "height": 960,
        "minWidth": 1180,
        "minHeight": 760
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../connectors/claude-code/mori-claude-hook.py": "connectors/claude-code/mori-claude-hook.py",
      "../connectors/claude-code/mori-claude-hook.sh": "connectors/claude-code/mori-claude-hook.sh",
      "../connectors/claude-code/mori-claude-hook.ps1": "connectors/claude-code/mori-claude-hook.ps1"
    }
  }
}
